# SonoAxis Local Runtime Environment Template
# Copy to .env for optional local customization. Do not commit real secrets.

# Network & Server Binding (strictly localhost-only for clinical privacy)
SONOVOICE_APP_HOST=127.0.0.1
SONOVOICE_APP_PORT=8000

# Speech Recognition (Faster-Whisper CPU INT8)
SONOVOICE_DEFAULT_MODEL=base.en
SONOVOICE_STT_DEVICE=cpu
SONOVOICE_STT_COMPUTE_TYPE=int8

# Optional Local Storage Overrides (defaults to project-relative data/ and models/)
# SONOVOICE_BASE_DIR=.
# SONOVOICE_DATA_DIR=./data
# SONOVOICE_AUDIO_DIR=./data/audio
# SONOVOICE_EXPORT_DIR=./data/exports
# SONOVOICE_DB_PATH=./data/sonovoice.db
# SONOVOICE_WHISPER_MODEL_DIR=./models/whisper

# Optional Non-Interactive Account Provisioning Variables (used only by cli_accounts)
# Prefer interactive getpass prompts when running python -m backend.app.cli_accounts
# SONOAXIS_RADIOLOGIST_PASSWORD=
# SONOAXIS_ADMIN_PASSWORD=
# SONOAXIS_NEW_PASSWORD=
